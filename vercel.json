{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "fix/email-normalization-release-20261110": false
    }
  },
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/expire-waitlist-offers",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/expire-credits",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/process-email-campaigns",
      "schedule": "0 8 * * *"
    }
  ]
}
