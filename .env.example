# Database (Neon PostgreSQL - https://neon.tech)
# Este archivo es una referencia, no una configuración lista para ejecutar.
# Desarrollo local: usar SOLO la rama Neon Preview verificada de Aleyda.
# Consultar docs/local-preview.md antes de sustituir archivos existentes.
DATABASE_URL="postgresql://USER:PASSWORD@ep-still-star-agi8b3ka-pooler.c-2.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Neon Pooled Connection (para serverless en Vercel)
# Obtener en: Neon Dashboard > Connection Details > Pooled connection
# DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/energia_y_divinidad?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Registro protegido y newsletter voluntaria. Configurar primero SOLO Preview.
# Turnstile Free, widgets y secretos separados por entorno. Claves de prueba
# oficiales solo en desarrollo/tests; Production las rechaza.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
AUTH_RATE_LIMIT_SECRET=""
REGISTRATION_NEWSLETTER_ENABLED="false"

# Google OAuth (obtener en https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID="81jpalr2"
NEXT_PUBLIC_SANITY_DATASET="preview"
PREVIEW_SANITY_DATASET="preview"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"
SANITY_API_TOKEN="your-sanity-token"
# Webhook secret for ISR revalidation (generate with: openssl rand -base64 32)
SANITY_WEBHOOK_SECRET="your-sanity-webhook-secret"

# ===========================================
# PASARELAS DE PAGO
# ===========================================

# PayPal (Internacional y Colombia - USD)
# Obtener credenciales en: https://developer.paypal.com/dashboard/ → Apps & Credentials → Create App
# Documentación: https://developer.paypal.com/docs/api/orders/v2/
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_WEBHOOK_ID="your-paypal-webhook-id"
PAYPAL_ENVIRONMENT="sandbox" # sandbox | live

# PayPal Billing Plans para Membresías Recurrentes
# Crear en: https://developer.paypal.com/dashboard/ → Subscriptions → Plans
# Necesitas crear 4 planes (mensual y anual × 2 tiers)
# Formato del Plan ID de PayPal: P-XXXXXXXXXXXXXXXXXXXXX
PAYPAL_PLAN_ID_ESENCIA_MONTHLY="P-your-plan-id-esencia-monthly"
PAYPAL_PLAN_ID_ESENCIA_YEARLY="P-your-plan-id-esencia-yearly"
PAYPAL_PLAN_ID_DIVINIDAD_MONTHLY="P-your-plan-id-divinidad-monthly"
PAYPAL_PLAN_ID_DIVINIDAD_YEARLY="P-your-plan-id-divinidad-yearly"


# Cron Jobs (Vercel Cron)
# Generar con: openssl rand -base64 32
CRON_SECRET="your-cron-secret"

# Bre-B · Global66 (cuenta personal, conciliación manual)
# Ámbito Production. Sin estos valores Bre-B queda deshabilitado y el checkout devuelve 503.
# GLOBAL66_BREB_KEY_TYPE: phone | email | alias | document
GLOBAL66_BREB_VERIFIED="true"
GLOBAL66_BREB_KEY="@ALIAS-DE-EJEMPLO"
GLOBAL66_BREB_KEY_TYPE="alias"
GLOBAL66_BREB_RECIPIENT="Titular tal como figura en Global66"
# El QR de la cuenta es estático y NO lleva importe: se reutiliza entre pedidos.
# Usar una de las dos formas. Vercel limita cada variable a 65536 caracteres.
# GLOBAL66_BREB_QR_DATA_URL="data:image/png;base64,..."
# GLOBAL66_BREB_QR_URL="https://..."
# Preview exige un QR distinto del de Production; si coincide, se ignora.
# PREVIEW_BREB_QR_URL="data:image/png;base64,..."

# Resend (Para envío de emails)
# Obtener API key en: https://resend.com/api-keys
# Solo la clave dedicada de Preview. Todos los destinatarios se sustituyen por esta cuenta.
RESEND_API_KEY="re_..."
EMAIL_FROM="Energía y Divinidad <noreply@energiaydivinidad.com>"
PREVIEW_EMAIL_RECIPIENT="aleydapaola@proton.me"
EMAIL_DELIVERY_MODE="preview"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature Flags
NEXT_PUBLIC_EVENTS_ENABLED="true"
