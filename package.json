{
  "name": "energia-y-divinidad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-local.mjs development next dev",
    "build": "prisma generate && node scripts/run-local.mjs production next build",
    "start": "node scripts/run-local.mjs production next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run format:check",
    "sanity": "node scripts/run-local.mjs development sanity dev",
    "sanity:deploy": "cd sanity && sanity deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/run-local.mjs development prisma migrate dev",
    "prisma:migrate:deploy": "node scripts/run-local.mjs development prisma migrate deploy",
    "prisma:studio": "node scripts/run-local.mjs development prisma studio",
    "local:check": "node scripts/run-local.mjs development next --version",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && node scripts/migrate-vercel.mjs && next build",
    "prepare": "husky",
    "test:preview": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@headlessui/react": "^2.2.9",
    "@paypal/paypal-server-sdk": "^2.2.0",
    "@paypal/react-paypal-js": "^8.9.2",
    "@portabletext/react": "^3.2.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-pdf/renderer": "^4.3.2",
    "@sanity/client": "^7.11.1",
    "@sanity/image-url": "^1.0.2",
    "@types/qrcode": "^1.5.6",
    "@vercel/blob": "^2.0.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "googleapis": "^173.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "next-sanity": "^11.6.13",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.3.1",
    "react-is": "^19.2.3",
    "resend": "^6.7.0",
    "styled-components": "^6.3.6",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@sanity/vision": "^5.31.2",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "groq-js": "1.24.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "prisma": "^6.19.3",
    "sanity": "^5.31.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.5",
    "glob@>=10.2.0 <10.5.0": "^10.5.0",
    "zod@>=4 <4.6.6": "$zod",
    "@sanity/uuid": "^3.0.3",
    "uuid@>=11.0.0 <11.1.1": "^11.1.1"
  }
}
